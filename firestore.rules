rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return verifiedUser() && request.auth.uid == "aVIhWxMYfRNciqRmuNselJyi1MP2";
    }

    function activeUser() {
      return verifiedUser()
        && !exists(/databases/$(database)/documents/deletedUsers/$(request.auth.uid));
    }

    function isSelf(userId) {
      return activeUser() && request.auth.uid == userId;
    }

    match /photos/{photoId} {
      // Only verified accounts can view; only the owner can manage archive data.
      allow read: if activeUser();
      allow create, update, delete: if isOwner();
    }

    match /collections/{collectionId} {
      allow read: if activeUser();
      allow create, update, delete: if isOwner();
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isOwner();
      // A newly registered user may only create their own active profile.
      //
      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "active"
        && request.resource.data.keys().hasOnly(["uid", "email", "status", "createdAt", "updatedAt"]);
      // Users can only keep their profile email current; admin controls status.
      allow update: if isOwner() || (isSelf(userId)
        && resource.data.status == "active"
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["email", "updatedAt"]));
      allow delete: if isOwner();

      match /favorites/{photoId} {
        allow read, create, update, delete: if isSelf(userId) || isOwner();
      }

      match /downloads/{photoId} {
        allow read, create, update, delete: if isSelf(userId) || isOwner();
      }
    }

    match /deletedUsers/{userId} {
      // A removed user may read only their own tombstone so the login gate
      // can show a clear message instead of recreating their profile.
      allow read: if (verifiedUser() && request.auth.uid == userId) || isOwner();
      allow create, update, delete: if isOwner();
    }
  }
}
