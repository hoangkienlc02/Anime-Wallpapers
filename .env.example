# Set these in Vercel Project Settings > Environment Variables. Never commit the real values.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=anime-wallpapers

# Firebase console: Authentication > Users > copy the UID of your only account.
ADMIN_UID=your_firebase_user_uid
# This is the Web API Key from Firebase project settings. It identifies the project, not a secret.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
